{
  "name": "sentinel-appsec-ide",
  "displayName": "Sentinel AppSec & Custom Rule Engine",
  "description": "Real-time AST security scanning, vulnerability diagnostics, hover tooltips, and project custom rules reflection (.sentinel/rules.yaml).",
  "version": "1.0.0",
  "publisher": "sentinel-security",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Linters",
    "Programming Languages",
    "Other"
  ],
  "keywords": [
    "security",
    "sast",
    "iac",
    "cisa-kev",
    "secrets",
    "owasp",
    "misra",
    "iso27001",
    "custom-rules"
  ],
  "main": "./src/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "workspaceContains:**/.sentinel/rules.yaml",
    "workspaceContains:**/.sentinel/rules.json",
    "onLanguage:python",
    "onLanguage:javascript",
    "onLanguage:typescript",
    "onLanguage:dockerfile",
    "onLanguage:yaml",
    "onLanguage:terraform"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sentinel-activity-bar",
          "title": "Sentinel AppSec",
          "icon": "resources/shield.svg"
        }
      ]
    },
    "views": {
      "sentinel-activity-bar": [
        {
          "id": "sentinel.rulesExplorer",
          "name": "Security & Custom Rules Explorer",
          "icon": "resources/rules.svg"
        },
        {
          "id": "sentinel.activeFlaws",
          "name": "Active Vulnerabilities & Diagnostics",
          "icon": "resources/shield.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "sentinel.scanCurrentFile",
        "title": "Sentinel: Scan Active Document",
        "category": "Sentinel AppSec",
        "icon": "$(search)"
      },
      {
        "command": "sentinel.scanWorkspace",
        "title": "Sentinel: Scan Entire Workspace",
        "category": "Sentinel AppSec",
        "icon": "$(shield)"
      },
      {
        "command": "sentinel.refreshRules",
        "title": "Sentinel: Refresh & Sync Custom Rules",
        "category": "Sentinel AppSec",
        "icon": "$(refresh)"
      },
      {
        "command": "sentinel.inspectRule",
        "title": "Sentinel: Inspect Security Rule",
        "category": "Sentinel AppSec"
      },
      {
        "command": "sentinel.openDashboard",
        "title": "Sentinel: Open Web Dashboard",
        "category": "Sentinel AppSec",
        "icon": "$(globe)"
      },
      {
        "command": "sentinel.applyQuickFix",
        "title": "Sentinel: Apply Remediation Fix",
        "category": "Sentinel AppSec"
      },
      {
        "command": "sentinel.configureCloud",
        "title": "Sentinel: Connect to Cloud Server & API Token",
        "category": "Sentinel AppSec",
        "icon": "$(cloud)"
      },
      {
        "command": "sentinel.autoDetectServer",
        "title": "Sentinel: Auto-Detect & Connect to Server IP",
        "category": "Sentinel AppSec",
        "icon": "$(broadcast)"
      },
      {
        "command": "sentinel.openRulesYaml",
        "title": "Sentinel: View / Open .sentinel/rules.yaml",
        "category": "Sentinel AppSec",
        "icon": "$(file-code)"
      },
      {
        "command": "sentinel.syncWorkspaceFindings",
        "title": "Sentinel: Sync Server Findings into IDE Problems",
        "category": "Sentinel AppSec",
        "icon": "$(sync)"
      },
      {
        "command": "sentinel.clearStoredResults",
        "title": "Sentinel: Clear Stored Findings & Diagnostics",
        "category": "Sentinel AppSec",
        "icon": "$(trash)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "sentinel.openRulesYaml",
          "when": "view == sentinel.rulesExplorer",
          "group": "navigation@0"
        },
        {
          "command": "sentinel.configureCloud",
          "when": "view == sentinel.rulesExplorer",
          "group": "navigation@1"
        },
        {
          "command": "sentinel.refreshRules",
          "when": "view == sentinel.rulesExplorer",
          "group": "navigation@2"
        },
        {
          "command": "sentinel.openDashboard",
          "when": "view == sentinel.rulesExplorer",
          "group": "navigation@3"
        },
        {
          "command": "sentinel.scanWorkspace",
          "when": "view == sentinel.activeFlaws",
          "group": "navigation@0"
        },
        {
          "command": "sentinel.clearStoredResults",
          "when": "view == sentinel.activeFlaws",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "sentinel.scanCurrentFile",
          "group": "sentinel@1"
        }
      ]
    },
    "configuration": {
      "title": "Sentinel AppSec Configuration",
      "properties": {
        "sentinel.serverUrl": {
          "type": "string",
          "default": "http://192.168.0.101:8000",
          "description": "Base URL of the Sentinel / AegisSec backend server"
        },
        "sentinel.apiToken": {
          "type": "string",
          "default": "",
          "description": "API Bearer Token or PAT for Sentinel backend authentication"
        },
        "sentinel.rulesFile": {
          "type": "string",
          "default": ".sentinel/rules.yaml",
          "description": "Relative path to project-level custom rules YAML or JSON file"
        },
        "sentinel.scanOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Automatically run security and custom rules audit on document save"
        },
        "sentinel.clearStoredResultsOnScan": {
          "type": "boolean",
          "default": true,
          "description": "Purge all previously stored/cached findings and diagnostics before running a scan"
        },
        "sentinel.autoSyncServerFindings": {
          "type": "boolean",
          "default": false,
          "description": "Automatically poll and mirror remote backend server findings into the local Problems tab (disabled by default so local Problems reflect only your real-time code changes)"
        },
        "sentinel.mergeServerFindings": {
          "type": "boolean",
          "default": false,
          "description": "Merge historical server findings into local editor scans (set to false to report only fresh scan findings)"
        },
        "sentinel.failOnSeverity": {
          "type": "string",
          "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW"],
          "default": "HIGH",
          "description": "Severity threshold for reporting blocking diagnostic errors"
        },
        "sentinel.allowInsecureTLS": {
          "type": "boolean",
          "default": false,
          "description": "Allow self-signed or unverified SSL/TLS certificates when connecting to Docker or private cloud servers"
        }
      }
    }
  }
}
