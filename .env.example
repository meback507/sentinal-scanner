# ================================================================
# Sentinel AppSec - Cloud & Docker Environment Configuration
# ================================================================

# --- Network & Server Runtime ---
PORT=8000
SENTINEL_PORT=8000
WORKERS=2
APP_ENV=production
PYTHONUNBUFFERED=1

# --- Storage & Database ---
# Path where SQLite database is stored inside the container volume
SENTINEL_DB_PATH=/app/data/sentinel.db

# --- Optional Integrations ---
# Jira Cloud Integration
# JIRA_URL=https://your-domain.atlassian.net
# JIRA_USER=admin@your-company.com
# JIRA_API_TOKEN=your-jira-api-token

# Zammad Helpdesk Integration
# ZAMMAD_URL=https://support.your-company.com
# ZAMMAD_TOKEN=your-zammad-token

# AI Remediation & Rule Generation Provider
# OPENAI_API_KEY=sk-...
